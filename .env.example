# Copy to `.env` and fill in. `.env` is gitignored.

# --- Service authentication (REQUIRED) ---
# The shared secret the Django core presents as `Authorization: Bearer <key>`.
# Without it, /api/v1 routes return 503 (fail closed).
SERVICE_API_KEY=change-me-to-a-long-random-secret

# NeMo is the required reference-G2P backend. Set to 0 only for intentional
# dictionary-only tests/development.
G2P_REQUIRE_NEMO=1

# --- Limits (optional; defaults shown) ---
# MAX_AUDIO_BYTES=20971520      # 20 MB
# MAX_AUDIO_SECONDS=60

# --- Database + uploads (optional) ---
# PRONUNCIATION_DB_PATH=./pronunciation_ai.db
# PRONUNCIATION_UPLOAD_DIR=./uploads

# --- CORS (optional; OFF by default — this is a server-to-server API) ---
# CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com

# --- Offline exercise-audio cleaning (DeepFilterNet + Silero VAD) ---
# Heavy models load lazily on the first cleaning request. Disabled by default.
# AUDIO_CLEANING_ENABLED=0
# AUDIO_CLEANING_USE_GPU=0
# AUDIO_CLEANING_MIN_DURATION_SECONDS=0.5
# AUDIO_CLEANING_MIN_SPEECH_SECONDS=0.3
# AUDIO_CLEANING_MAX_CLIPPING_RATIO=0.01
# AUDIO_CLEANING_MIN_SPEECH_RATIO=       # optional; blank means no ratio rejection
# AUDIO_CLEANING_KEEP_INTERMEDIATE_FILES=0
# AUDIO_CLEANING_TIMEOUT_SECONDS=120
# AUDIO_CLEANING_OUTPUT_DIR=./uploads
# FFMPEG_BINARY=ffmpeg

# --- External cleaning fallback (optional) ---
# Used only when the local DeepFilterNet/Silero processing path fails.
# The recording is sent to Cleanvoice only during that fallback attempt.
# CLEANVOICE_API_KEY=your-cleanvoice-api-key
# CLEANVOICE_FALLBACK_ENABLED=1
# CLEANVOICE_HTTP_TIMEOUT=120
# CLEANVOICE_STUDIO_SOUND=0

# --- LLM exercise-generation fallback (optional; retrieval-only without it) ---
# GEMINI_API_KEY=your-gemini-key-here
# EXERCISE_LLM_MODEL=gemini-flash-latest
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
